# Copy this file to central.env, replace every placeholder, then keep central.env private.
POSTGRES_DB=tokenlens
POSTGRES_ADMIN_USER=tokenlens_admin
POSTGRES_PASSWORD=replace-with-a-long-random-admin-password
CENTRAL_DB_PASSWORD=replace-with-a-different-long-random-ingest-password

# Each host ID gets its own random token. Configure each host with its matching token.
CENTRAL_INGEST_TOKENS_JSON={"host-01":"replace-with-a-random-token-of-at-least-32-characters","host-02":"replace-with-a-different-random-token-of-at-least-32-characters"}

# Loopback-only by default. Put a TLS reverse proxy in front before exposing to other hosts.
CENTRAL_BIND_HOST=127.0.0.1
CENTRAL_PORT=8080
CENTRAL_DOMAIN=finops.example.com
