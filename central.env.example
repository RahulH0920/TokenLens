# Copy to central.env, set a password matching the pgAdmin bootstrap SQL,
# and keep central.env private. The API listens on loopback by default.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=tokenlens
PGUSER=tokenlens_ingest
PGPASSWORD=replace-with-a-long-random-password
PGSSLMODE=prefer

# Each host ID gets its own random token. Configure each host with its matching token.
CENTRAL_INGEST_TOKENS_JSON={"host-01":"replace-with-a-random-token-of-at-least-32-characters","host-02":"replace-with-a-different-random-token-of-at-least-32-characters"}
